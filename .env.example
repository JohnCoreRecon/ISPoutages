# Copy to .env and fill in. The dashboard runs in DEMO mode until a key is set.

# Required for live checks — your Anthropic API key (kept server-side, never exposed):
ANTHROPIC_API_KEY=

# Optional overrides:
PORT=3000
MODEL=claude-sonnet-4-6
CACHE_SECONDS=90

# Optional: lock the dashboard behind a login (format user:pass). Leave blank for open access.
BASIC_AUTH=
